Set Shell "bash"
Set FontSize 13
Set Width 1000
Set Height 750
Set Theme "Dracula"
Set Padding 10

Type "./tcal"
Enter
Sleep 1s

# gezinme
Type "lll"
Sleep 600ms
Type "hh"
Sleep 600ms

# gorev ekle: :e
Type ":e"
Enter
Sleep 500ms
